# Tool version pins for cure-hht/event_sourcing — single source of truth.
# Sourced by scripts/check-elspais-version.sh (the pre-push gate). No other file
# in this repo may carry an elspais version literal; bump it here only.

# elspais (requirement validation and traceability)
# Pinned at 0.118.16 (CUR-1556): `match = "source"` (renamed from "precise" in
# 0.118.x; older elspais rejects "source", newer rejects "precise") and source
# matching wires real RESULT->TEST edges so the viewer's per-assertion Verified
# panel populates for flutter-machine targets. The local pre-push `elspais
# checks` hook is gated on installing >= this version.
# Bumped to 0.121.0 (CUR-1701) to match hht_diary's pin. No .elspais.toml
# schema change needed — `match = "source"` and this repo's coverage defaults
# are unchanged; `elspais checks --lenient` (the pre-push gate) passes clean.
ELSPAIS_VERSION=0.121.0
