# Tool version pins for cure-hht/event_sourcing — single source of truth.
# Sourced by scripts/check-elspais-version.sh (the pre-push gate), by
# tools/run-checks.sh (`make`) and by every job of
# .github/workflows/event-sourcing-tests.yml. No hook, workflow or check
# script carries one of these versions as a literal; bump each here only.

# elspais (requirement validation and traceability)
# The pre-push `elspais checks` gate is satisfied by installing at least this
# version. It also governs the requirement hashes committed under spec/: they
# are generated by a version that computes them this way, and one that computes
# them differently reports every requirement as stale.
#
# The pin must satisfy the checked-in .elspais.toml: `match = "source"` on the
# test targets, which wires RESULT->TEST edges so the viewer's per-assertion
# Passing panel populates for flutter-machine targets. The keys 0.121 retired
# -- `separators`, `prefix_optional` and `component.max_length` -- are absent
# for the same reason.
#
# This pin also has to satisfy the repositories that link this one as an
# elspais associate: federation loads this configuration with the consumer's
# binary, so a version older than theirs is a config they cannot read.
#
# `make evidence` requires exactly this version: CI verifies the committed
# Evidence Snapshot with it, and the snapshot's report is that version's
# rendering.
ELSPAIS_VERSION=0.125.51

# Flutter SDK. Every workflow job installs this version, so a new stable
# release or lint set cannot change a run's outcome. `make evidence` refuses
# another installed version, because the Evidence Snapshot records this one
# as its `flutter` fact.
FLUTTER_VERSION=3.44.7

# Postgres server image. CI's Postgres services run it, and the throwaway
# containers of tools/run-checks.sh start it unless PG_IMAGE names another.
# The Evidence Snapshot records it as its `postgres` fact.
POSTGRES_IMAGE=postgres:16
